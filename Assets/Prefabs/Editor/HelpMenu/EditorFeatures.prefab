--- !u!114 &3276216359264292462
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3276216359264292460}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><align=center><size=125%><font=\"Kurokane\" material=\"Kurokane Outline\">Playback</font></size></align></b>\r\n<sprite=\"Icons\"
    name=\"play\"> - Play \r\nPlays the level from the current playback start position.\r\n<sprite=\"Icons\"
    name=\"pause\"> - Pause\r\nPauses the level playback, so you can resume it again.\r\n<sprite=\"Icons\"
    name=\"stop\"> - Stop\r\nStops level playback, so you can restart from the playback
    start position.\r\n<sprite=\"Icons\" name=\"autoplay\"> - Autoplay\r\nToggles
    autoplay <color=#52ff4a>on</color> and <color=#aaaaaa>off</color>.\r\n<sprite=\"Icons\"
    name=\"metronome\"> - Metronome\r\nToggles the metronome. Right click it to change
    the subdivision between <color=#009ec5>quarter notes</color>, <color=#d97a04>eighth
    notes</color>, and <color=#3ac011>sixteenth notes</color>.\r\n\r\n<b><align=center><size=125%><font=\"Kurokane\"
    material=\"Kurokane Outline\">Level Features</font></size></align></b>\r\n<sprite=\"Icons\"
    name=\"newFile\"> - New\r\nCreate a new level.\r\n<sprite=\"Icons\" name=\"openFile\">
    - Open\r\nOpen an existing level.\r\n<sprite=\"Icons\" name=\"save\"> - Save
    Project\r\nSave your currently opened level.\r\n<sprite=\"Icons\" name=\"undo\">
    - Undo\r\nUndoes your last change.\r\n<sprite=\"Icons\" name=\"redo\"> - Redo\r\nRedoes
    your last undo.\r\n<sprite=\"Icons\" name=\"copy\"> - Copy\r\nCopies your currently
    selected events.\r\n<sprite=\"Icons\" name=\"paste\"> - Paste\r\nPastes your
    currently copied events to your playback start position.\r\n<sprite=\"Icons\"
    name=\"tapper\"> - Tempo Finder\r\nOpens the Tempo Tapper, to help find the BPM
    of your current song. \r\n<sprite=\"Icons\" name=\"addMusic\"> - Music Select\r\nSet
    a song file. OGG is the recommended format, but MP3, WAV, AIFF, and FLAC can
    be opened.\r\n<sprite=\"Icons\" name=\"properties\"> - Remix Properties\r\nSet
    the properties of your level, including:<line-height=1.5em>\r\n<indent=2em>-
    Remix Title\r\n- Description\r\n- Remix Creator\r\n- Song Title\r\n- Composer\r\n-
    Results Text\r\n- Epilogue Images</line-height></indent>\r\n<sprite=\"Icons\"
    name=\"addAsset\"> - Remix Assets\r\nAdd assets to your level. Currently, this
    includes:<line-height=1.5em>\r\n<indent=2em>- Images</indent>\r\n<indent=2em>-
    Sound Effects</indent></line-height>\r\n\r\n<b><align=center><size=125%><font=\"Kurokane\"
    material=\"Kurokane Outline\">Tools</font></size></align></b>\r\n<sprite=\"Icons\"
    name=\"zoomIn\"> - Zoom\r\nChange the zoom of the timeline. Up and down zoom
    vertically, while left and right zoom horizontally. Click <sprite=\"Icons\" name=\"resetZoom\">
    to reset the zoom to its default.\r\n<sprite=\"Icons\" name=\"snap\"> - Snap\r\nSet
    the snap size of the timeline when moving events around. Defaults to 1/4 (sixteenth
    notes)\r\n<sprite=\"Icons\" name=\"tracks\"> - Add/Remove Tracks\r\nAdd or remove
    a track from the timeline. The minimum number of tracks is 10, while the max
    is 50. A track can't be removed if it has an event on it!\r\n\r\n<sprite=\"Icons\"
    name=\"cursor\"> - Selection\r\nThe default selection tool. Left click and drag
    to select events.\r\n<sprite=\"Icons\" name=\"tempo\"> - Tempo Change\r\nLets
    you change the tempo at any point in the level. Left click the gap between the
    beat numbers and the timeline to place one, and right click it to change its
    properties or delete it.\r\n<sprite=\"Icons\" name=\"volume\"> - Music Volume\r\nLets
    you change the music volume at any point in the level. Left click the gap between
    the beat numbers and the timeline to place one, and right click it to change
    its properties or delete it.\r\n<sprite=\"Icons\" name=\"bookmark\"> - Markers\r\nSets
    a section marker down. Left click the gap between the beat numbers and the timeline
    to place one, and right click it to change its properties or delete it. Section
    markers can control ratings categories, input weight, and if named can provide
    Section Medals.\r\n\r\n<b><align=center><size=125%><font=\"Kurokane\" material=\"Kurokane
    Outline\">Minigames List</font></size></align></b>\r\n<sprite=\"Icons\" name=\"a-z\">
    - Sort Alphabetically\r\nSorts the minigames based on their names from A to Z.\r\n<sprite=\"Icons\"
    name=\"fave\"> - Sort by Favorite\r\nSorts the minigames with your favorite minigames
    first (Right click a game to add it to your favorites. They are cleared after
    the program is closed.) The remaining games are sorted alphabetically.\r\n<sprite=\"Icons\"
    name=\"usage\"> - Sort Chronologically\r\nSorts the minigames based on when they
    released, and when they appeared in their respective Rhythm Heaven games.\r\n<sprite=\"Icons\"
    name=\"bars\"> - Sort by Usage\r\nSorts the minigames based on how many events
    they have within your current level. Minigames not in your level are sorted alphabetically.\r\n\r\n<b><align=center><size=125%><font=\"Kurokane\"
    material=\"Kurokane Outline\">Advanced Features</font></size></align></b>\r\nYou
    can enable the Advanced Editor Features in the Editor Settings. These features
    may require further music theory knowledge and/or Unity knowledge to use properly.
    Tread with caution!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4810e200fa0cb24438bac52343d7674b, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 6d4610587e293f74ca2b71ec1cf59da3, type: 2}
